# Copy to .env and fill in. Never commit real values.

# Same Mongo server as the Flow project, separate database name.
# Local Docker: mongodb://127.0.0.1:27017/studyos
# Atlas: mongodb+srv://USER:PASS@CLUSTER.mongodb.net/studyos?appName=studyos
MONGO_URI=mongodb://127.0.0.1:27017/studyos

# Server-only. The browser never receives this.
GEMINI_API_KEY=
# Official model id. Change this without editing source.
# gemini-2.5-flash and gemini-2.0-flash return 404 for new keys. Use a current Flash model: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_OUTPUT_TOKENS=2048

# Required for /api/v1 routes. The web UI uses server actions and does not put this in the browser.
STUDYOS_API_TOKEN=

# Calendar used for "today", streaks, and reminder times.
APP_TIMEZONE=Asia/Kolkata
